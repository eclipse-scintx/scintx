{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scintx.example/schema/submission.schema.json",
  "title": "Submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "status", "acceptedAt", "artifact"],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^submission-[0-9a-f]{32}$"
    },
    "status": {
      "type": "string",
      "enum": ["accepted", "running", "completed", "failed"]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "interruptions": {
      "description": "Attempts cut short by a graceful gateway shutdown. They do not count toward the attempt cap.",
      "type": "integer",
      "minimum": 0
    },
    "acceptedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifact": {
      "$ref": "artifact.schema.json"
    },
    "error": {
      "type": "string"
    }
  }
}
