{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scintx.example/schema/artifact.schema.json",
  "title": "ArtifactInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "purl": {
      "type": "string",
      "pattern": "^pkg:[a-zA-Z0-9._-]+/.+"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["sha256", "sha384", "sha512"]
        },
        "value": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{32,128}$"
        }
      }
    },
    "filename": {
      "type": "string"
    },
    "mediaType": {
      "type": "string"
    },
    "contentMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeBytes"],
      "properties": {
        "filename": { "type": "string" },
        "mediaType": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "anyOf": [
    { "required": ["purl"] },
    { "required": ["digest"] },
    { "required": ["contentMeta"] }
  ]
}
