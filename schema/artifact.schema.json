{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scintx.example/schema/artifact.schema.json",
  "title": "ArtifactInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "purl": {
      "type": "string",
      "pattern": "^pkg:[a-zA-Z0-9._-]+/.+"
    },
    "digest": {
      "type": "string",
      "pattern": "^(sha256:[a-fA-F0-9]{64}|sha384:[a-fA-F0-9]{96}|sha512:[a-fA-F0-9]{128})$"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "sizeBytes"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "filename": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        }
      }
    }
  },
  "anyOf": [
    { "required": ["purl"] },
    { "required": ["digest"] },
    { "required": ["content"] }
  ]
}
