{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scintx.example/schema/artifact.schema.json",
  "title": "ArtifactInput",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "maxProperties": 1,
  "properties": {
    "purl": {
      "type": "string",
      "pattern": "^pkg:[a-zA-Z0-9._-]+/.+"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["sha256", "sha384", "sha512"]
        },
        "value": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]+$"
        }
      },
      "oneOf": [
        {
          "properties": {
            "algorithm": { "const": "sha256" },
            "value": { "pattern": "^[a-fA-F0-9]{64}$" }
          }
        },
        {
          "properties": {
            "algorithm": { "const": "sha384" },
            "value": { "pattern": "^[a-fA-F0-9]{96}$" }
          }
        },
        {
          "properties": {
            "algorithm": { "const": "sha512" },
            "value": { "pattern": "^[a-fA-F0-9]{128}$" }
          }
        }
      ]
    },
    "contentMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "sizeBytes"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "filename": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        }
      }
    }
  },
  "oneOf": [
    { "required": ["purl"] },
    { "required": ["digest"] },
    { "required": ["contentMeta"] }
  ]
}
