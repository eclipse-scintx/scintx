{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scintx.example/schema/aggregate-report.schema.json",
  "title": "AggregateReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "submission",
    "artifact",
    "gateway",
    "policy",
    "providers",
    "providerRuns",
    "providerReports"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "id": { "type": "string", "minLength": 1 },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "acceptedAt"],
      "properties": {
        "id": { "type": "string" },
        "acceptedAt": { "type": "string" }
      }
    },
    "artifact": {
      "$ref": "https://scintx.example/schema/artifact.schema.json"
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceId", "version", "configuration"],
      "properties": {
        "instanceId": { "type": "string" },
        "version": { "type": "string" },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "snapshotRef"],
          "properties": {
            "revision": { "type": "string" },
            "snapshotRef": { "type": "string" }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "capabilities", "evaluationDeadlineMs"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evaluationDeadlineMs": { "type": "integer", "minimum": 1 }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "adapterVersion", "available", "eligible", "selected", "matched_capabilities", "reasons"],
        "properties": {
          "slug": { "type": "string" },
          "adapterVersion": { "type": "string" },
          "available": { "type": "boolean" },
          "eligible": { "type": "boolean" },
          "selected": { "type": "boolean" },
          "matched_capabilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reasons": {
            "type": "array",
            "items": { "type": "string" }
          },
          "providerRunId": { "type": "string" }
        }
      }
    },
    "providerRuns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "status", "startedAt", "completedAt", "durationMs", "reportId"],
        "properties": {
          "id": { "type": "string" },
          "provider": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["completed", "failed", "timed_out", "incomplete"]
          },
          "startedAt": { "type": "string" },
          "completedAt": { "type": ["string", "null"] },
          "durationMs": { "type": "integer", "minimum": 0 },
          "reportId": { "type": ["string", "null"] },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "retryable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "providerReports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "providerRunId", "provider", "capabilities", "providerVerdict"],
        "properties": {
          "schemaVersion": { "type": "string" },
          "id": { "type": "string" },
          "providerRunId": { "type": "string" },
          "provider": { "type": "string" },
          "adapterVersion": { "type": "string" },
          "capabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "findings"],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["completed", "partial", "unavailable"]
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "status"],
                    "properties": {
                      "id": { "type": "string" },
                      "status": { "type": "string" }
                    }
                  }
                },
                "findings": {
                  "type": "array",
                  "items": { "$ref": "https://scintx.example/schema/finding.schema.json" }
                }
              }
            }
          },
          "providerVerdict": { "type": ["string", "null"] },
          "responseMetadata": { "type": "object" },
          "rawEvidenceRef": { "type": "string" }
        }
      }
    }
  }
}
