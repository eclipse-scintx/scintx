{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scintx.example/schema/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "severity", "title"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info", "unknown"]
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "artifact": {
      "$ref": "https://scintx.example/schema/artifact.schema.json"
    },
    "dependencyPath": {
      "type": "array",
      "items": { "type": "string" }
    },
    "identifiers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata": {
      "type": "object"
    }
  }
}
