# Eclipse SCINTX Gateway environment variables
# Copy to .env and adjust, or export before `make run` / `./bin/scintx`.

# Listen address for the gateway HTTP server. Default: :8080
SCINTX_ADDR=:8080

# Optional path to gateway YAML config file. Default: ./gateway.yaml (if present)
# SCINTX_CONFIG=./gateway.yaml

# Gateway instance identifier. Default: gateway-001
# SCINTX_INSTANCE_ID=gateway-001

# Persistent database DSN (SQLite file path/URI or PostgreSQL URI).
# Supports *_FILE for container secret mounts. Default: file:data/scintx.db
# Examples:
#   SCINTX_DATABASE_URL=file:data/scintx.db
#   SCINTX_DATABASE_URL=postgres://scintx:password@localhost:5432/scintx?sslmode=disable
#   SCINTX_DATABASE_URL="host=localhost port=5432 user=scintx password=secret dbname=scintx"
#   SCINTX_DATABASE_URL_FILE=/run/secrets/scintx_database_url
SCINTX_DATABASE_URL=file:data/scintx.db

# Directory for uploaded content ("content" uploads). A file stays here only
# until its submission is finished, then it is deleted. Gateways that share
# one database must share this directory. Default: data/blobs
# SCINTX_BLOB_DIR=data/blobs

# Optional Bearer token required from consumers calling /v1/* endpoints.
# Supports *_FILE for container secret mounts.
# SCINTX_AUTH_BEARER_TOKEN=
# SCINTX_AUTH_BEARER_TOKEN_FILE=/run/secrets/scintx_bearer_token
